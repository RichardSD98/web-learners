# Preview mode: serve a paper the question bank cannot fill, labelled on every
# screen as a preview and marked against no pass mark. Off by default, and it
# must stay off in any build a learner will see - the point of the app is that a
# short paper is refused rather than dressed up as the test.
#
# Copy this file to .env.local and set it to true to click through the flow while
# the bank is still being transcribed.
NEXT_PUBLIC_PREVIEW_MODE=false
